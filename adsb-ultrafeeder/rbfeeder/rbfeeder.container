[Unit]
Description=RadarBox Feeder
After=podman-user-wait-network-online.service adsb-network.service ultrafeeder.service
Wants=podman-user-wait-network-online.service adsb-network.service
BindsTo=ultrafeeder.service
PartOf=ultrafeeder.service

[Container]
HostName=rbfeeder
ContainerName=rbfeeder
Image=ghcr.io/sdr-enthusiasts/docker-airnavradar:latest
Network=adsb
AutoUpdate=registry
Environment=TZ=America/New_York
Environment=BEASTHOST=ultrafeeder
Environment=BEASTPORT=30005
Environment=MLAT_RESULTS_BEASTHOST=ultrafeeder
Environment=MLAT_RESULTS_BEASTPORT=31004
Environment=UAT_RECEIVER_HOST=dump978
Environment=UAT_RECEIVER_PORT=30978
EnvironmentFile=%h/.config/containers/systemd/rbfeeder.env
NoNewPrivileges=yes
DropCapability=all
AddCapability=CAP_NET_BIND_SERVICE
AddCapability=CAP_SETUID
AddCapability=CAP_SETGID
AddCapability=CAP_CHOWN
AddCapability=CAP_DAC_OVERRIDE
Mount=type=tmpfs,destination=/run,tmpfs-size=64M,tmpfs-mode=1777
Mount=type=tmpfs,destination=/tmp,tmpfs-size=64M,tmpfs-mode=1777
Mount=type=tmpfs,destination=/var/log,tmpfs-size=64M,tmpfs-mode=1777
Mount=type=tmpfs,destination=/etc,tmpfs-size=16M,tmpfs-mode=1777
Environment=RB_SERVER=true
Environment=S6_READ_ONLY_ROOT=1
ReadOnly=yes

[Service]
Restart=always

[Install]
WantedBy=default.target
