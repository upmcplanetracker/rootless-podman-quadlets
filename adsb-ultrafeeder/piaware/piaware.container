[Unit]
Description=PiAware Feeder (Rootless)
After=podman-user-wait-network-online.service adsb-network.service ultrafeeder.service
Wants=podman-user-wait-network-online.service adsb-network.service 
Requires=ultrafeeder.service

[Container]
Image=ghcr.io/sdr-enthusiasts/docker-piaware:latest
HostName=piaware
ContainerName=piaware
Environment=TZ=America/New_York
EnvironmentFile=%h/.config/containers/systemd/piaware.env
NoNewPrivileges=yes
Network=adsb.network:mtu=1500
PublishPort=8011:80
DropCapability=all
AddCapability=CAP_CHOWN
AddCapability=CAP_DAC_OVERRIDE
AddCapability=CAP_NET_BIND_SERVICE
AddCapability=CAP_SETUID
AddCapability=CAP_SETGID
AddCapability=CAP_NET_ADMIN
Environment=RECEIVER_TYPE=relay
Environment=RECEIVER_HOST=ultrafeeder
Environment=RECEIVER_PORT=30005
Environment=BEASTHOST=ultrafeeder
Environment=BEASTPORT=30005
Environment=S6_SERVICE_DEPS_dump1090=disabled
Environment=S6_SERVICE_DEPS_skyaware=disabled
Environment=S6_SERVICE_DEPS_dump978=disabled
Environment=S6_SERVICE_DEPS_skyaware978=disabled
Mount=type=tmpfs,destination=/run,tmpfs-size=64M,tmpfs-mode=1777
Mount=type=tmpfs,destination=/var/log,tmpfs-size=64M,tmpfs-mode=1777
Mount=type=tmpfs,destination=/tmp,tmpfs-size=64M,tmpfs-mode=1777
Mount=type=tmpfs,destination=/var/cache,tmpfs-size=32M,tmpfs-mode=1777
Mount=type=tmpfs,destination=/etc,tmpfs-size=64M,tmpfs-mode=1777
Environment=Piaware_UID=1000
Environment=Piaware_GID=1000
AutoUpdate=registry
StopSignal=SIGKILL
Environment=S6_READ_ONLY_ROOT=1
ReadOnly=yes

[Service]
ExecStartPre=/bin/sleep 20
#Restart=on-failure
ExecStartPost=/usr/bin/podman exec piaware ip link set dev eth0 mtu 1500

[Install]
WantedBy=default.target
