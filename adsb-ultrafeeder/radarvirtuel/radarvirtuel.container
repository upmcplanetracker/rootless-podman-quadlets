[Unit]
Description=RadarVirtuel Feeder (Rootless)
After=podman-user-wait-network-online.service adsb-network.service ultrafeeder.service
Wants=podman-user-wait-network-online.service adsb-network.service
BindsTo=ultrafeeder.service
PartOf=ultrafeeder.service

[Container]
HostName=radarvirtuel
ContainerName=radarvirtuel
Image=ghcr.io/sdr-enthusiasts/docker-radarvirtuel:latest
Network=adsb
AutoUpdate=registry
EnvironmentFile=%h/.config/containers/systemd/radarvirtuel.env
Environment=TZ=America/New_York
Volume=%h/radarvirtuel/data:/data:rw
Volume=/proc/cpuinfo:/host/cpuinfo:ro
Volume=/etc/localtime:/etc/localtime:ro
NoNewPrivileges=yes
DropCapability=all
AddCapability=CAP_NET_BIND_SERVICE
AddCapability=CAP_SETUID
AddCapability=CAP_SETGID
Mount=type=tmpfs,destination=/tmp,tmpfs-size=128M,tmpfs-mode=1777
Environment=S6_READ_ONLY_ROOT=1
ReadOnly=yes
Mount=type=tmpfs,destination=/var/log,tmpfs-size=64M,tmpfs-mode=1777
Mount=type=tmpfs,destination=/opt/feeder_rv,tmpfs-size=4M,tmpfs-mode=1777
StopSignal=SIGKILL

[Service]
Restart=always

[Install]
WantedBy=default.target
